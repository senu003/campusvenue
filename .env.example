# CampusVenue Local Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Backend ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# PostgreSQL Configuration
POSTGRES_DB=campusvenue_dev
POSTGRES_USER=campusvenue_user
POSTGRES_PASSWORD=campusvenue_dev_secret_change_me
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection Strings
# For host-running API connecting to Docker PostgreSQL:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=campusvenue_dev;Username=campusvenue_user;Password=campusvenue_dev_secret_change_me;Include Error Detail=true
# For containerized API connecting to containerized PostgreSQL:
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=campusvenue_dev;Username=campusvenue_user;Password=campusvenue_dev_secret_change_me

# Frontend Vite Settings
VITE_API_BASE_URL=http://localhost:5000
FRONTEND_PORT=3000

# CORS Allowed Origins (Comma-separated)
AllowedCorsOrigins=http://localhost:3000,http://127.0.0.1:3000
